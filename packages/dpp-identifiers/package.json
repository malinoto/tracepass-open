{
  "name": "@tracepass/dpp-identifiers",
  "version": "0.13.1",
  "description": "Validate and parse EU Digital Product Passport identifiers (EN 18219) — GS1 Digital Link, ISO/IEC 15459, IEC 61406, DID, DOI. Pure functions, no network, no third-party runtime dependencies.",
  "keywords": [
    "digital-product-passport",
    "dpp",
    "en18219",
    "espr",
    "gs1",
    "gtin",
    "iso15459",
    "iec61406",
    "did",
    "doi",
    "identifier",
    "eu-regulation",
    "circular-economy"
  ],
  "license": "Apache-2.0",
  "author": "TracePass LTD (https://tracepass.eu)",
  "homepage": "https://github.com/malinoto/tracepass-open/tree/main/packages/dpp-identifiers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malinoto/tracepass-open.git",
    "directory": "packages/dpp-identifiers"
  },
  "bugs": "https://github.com/malinoto/tracepass-open/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tracepass/dpp-types": "^0.13.1",
    "@tracepass/gs1-utils": "^0.13.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
