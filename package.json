{
  "name": "tracepass-open",
  "private": true,
  "description": "Open-source building blocks for EU Digital Product Passports (ESPR), maintained by TracePass.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malinoto/tracepass-open.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w @tracepass/dpp-types -w @tracepass/gs1-utils && npm run build -w @tracepass/dpp-epcis -w @tracepass/dpp-validate -w @tracepass/dpp-identifiers",
    "clean": "npm run clean --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "if [ -f node_modules/@tracepass/code-standard/git-hooks/install.mjs ]; then node node_modules/@tracepass/code-standard/git-hooks/install.mjs; fi",
    "check:rule-drift": "node scripts/check-rule-drift.mjs",
    "build:rule-surface": "node scripts/build-rule-surface.mjs",
    "check:mirrors": "node scripts/check-mirrors.mjs",
    "build:mirror-manifest": "node scripts/build-mirror-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tracepass/code-standard": "^1.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  },
  "prettier": "@tracepass/code-standard/prettier",
  "engines": {
    "node": ">=18"
  }
}
